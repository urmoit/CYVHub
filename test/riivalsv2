        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
        if h then h.WalkSpeed = 25.2; h.JumpPower = 20 end

        stopFly()
        stopInfiniteJump()
        stopLoopSpeed()
        stopLoopPower()

        for _, conn in ipairs(connections) do
            if typeof(conn) == "RBXScriptConnection" then pcall(function() conn:Disconnect() end) end
        end
        for _, conn in pairs(HumanModCons) do
            if typeof(conn) == "RBXScriptConnection" then pcall(function() conn:Disconnect() end) end
        end

        if DrawingCircle        then pcall(function() DrawingCircle:Remove() end) DrawingCircle = nil end
        if shared.CYV_FOVConn   then pcall(function() shared.CYV_FOVConn:Disconnect() end) end
        if shared.CYV_FOVCircle then pcall(function() shared.CYV_FOVCircle:Remove() end) end

        clearAllESP()
        Starlight:Destroy()
    end,
}, "UnloadButton")


