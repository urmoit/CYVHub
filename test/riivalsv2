local espDrawings = {}
local highlights = {}

local function clearPlayerESP(player)
    local pDraw = espDrawings[player]
    if pDraw then
        for _, obj in pairs(pDraw) do
            pcall(function() obj:Remove() end)
        end
        espDrawings[player] = nil
    end
    local hl = highlights[player]
    if hl then pcall(function() hl:Destroy() end) end
    highlights[player] = nil
end

local function clearAllESP()
    for player in pairs(espDrawings) do clearPlayerESP(player) end
end

local function getBoneConnections(character)
    local connections = {}
    local function add(a, b)
        local p1, p2 = character:FindFirstChild(a), character:FindFirstChild(b)
        if p1 and p2 then table.insert(connections, {p1, p2}) end
    end
    add("Head", "UpperTorso")
    add("UpperTorso", "LowerTorso")
    add("UpperTorso", "LeftUpperArm")
    add("LeftUpperArm", "LeftLowerArm")
    add("LeftLowerArm", "LeftHand")
    add("UpperTorso", "RightUpperArm")
    add("RightUpperArm", "RightLowerArm")
    add("RightLowerArm", "RightHand")
    add("LowerTorso", "LeftUpperLeg")
    add("LeftUpperLeg", "LeftLowerLeg")
    add("LeftLowerLeg", "LeftFoot")
    add("LowerTorso", "RightUpperLeg")
    add("RightUpperLeg", "RightLowerLeg")
    add("RightLowerLeg", "RightFoot")
    return connections
end

local function createPlayerESP(player)
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    local humanoid = character:FindFirstChildWhichIsA("Humanoid")
    if not hrp or not head or not humanoid or humanoid.Health <= 0 then return end

    local hp = math.max(humanoid.Health, 0)
    local maxHp = math.max(humanoid.MaxHealth, 1)
    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    if not onScreen then return end

    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
    if dist > 1000 then return end

    local size = character:GetExtentsSize()
    local cf = hrp.CFrame
    local topPos = cf * CFrame.new(0, size.Y/2, 0).Position
    local bottomPos = cf * CFrame.new(0, -size.Y/2, 0).Position
    local top, topOn = Camera:WorldToViewportPoint(topPos)
    local bottom, botOn = Camera:WorldToViewportPoint(bottomPos)
    if not topOn or not botOn then return end

    local screenH = bottom.Y - top.Y
    local boxW = screenH * 0.65
    local boxPos = Vector2.new(top.X - boxW/2, top.Y)
    local boxSize = Vector2.new(boxW, screenH)

    local pDraw = espDrawings[player] or {}
    espDrawings[player] = pDraw

    local color = Config.EnemyColor
    local hpColor = getHealthColor(hp / maxHp)

    -- ── Chams / Highlight ───────────────────────────────
    if Config.ShowChams then
        local hl = highlights[player]
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "ESPHighlight"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = character
            highlights[player] = hl
        end
        hl.FillColor = color
        hl.FillTransparency = 0.4
        hl.OutlineColor = Color3.fromRGB(0, 0, 0)
        hl.OutlineTransparency = 0
        hl.Enabled = true
    else
        local hl = highlights[player]
        if hl then pcall(function() hl:Destroy() end) end
        highlights[player] = nil
    end

    -- ── Box Corners ─────────────────────────────────────
    local cornerLen = boxW * 0.2
    local boxKeys = {"tl", "tr", "bl", "br", "lv", "rv", "tv", "bv"}
    for _, key in ipairs(boxKeys) do
        if not pDraw[key] then
            pDraw[key] = Drawing.new("Line")
            pDraw[key].Color = color
            pDraw[key].Thickness = 1.2
            pDraw[key].Transparency = 0.6
        end
    end

    pDraw.tl.From = boxPos
    pDraw.tl.To = boxPos + Vector2.new(cornerLen, 0)

    pDraw.tr.From = boxPos + Vector2.new(boxSize.X, 0)
    pDraw.tr.To = boxPos + Vector2.new(boxSize.X - cornerLen, 0)

    pDraw.bl.From = boxPos + Vector2.new(0, boxSize.Y)
    pDraw.bl.To = boxPos + Vector2.new(cornerLen, boxSize.Y)

    pDraw.br.From = boxPos + Vector2.new(boxSize.X, boxSize.Y)
    pDraw.br.To = boxPos + Vector2.new(boxSize.X - cornerLen, boxSize.Y)

    -- Vertical sides
    pDraw.lv.From = boxPos
    pDraw.lv.To = boxPos + Vector2.new(0, cornerLen)

    pDraw.rv.From = boxPos + Vector2.new(boxSize.X, 0)
    pDraw.rv.To = boxPos + Vector2.new(boxSize.X, cornerLen)

    pDraw.tv.From = boxPos + Vector2.new(0, boxSize.Y)
    pDraw.tv.To = boxPos + Vector2.new(0, boxSize.Y - cornerLen)

    pDraw.bv.From = boxPos + Vector2.new(boxSize.X, boxSize.Y)
    pDraw.bv.To = boxPos + Vector2.new(boxSize.X, boxSize.Y - cornerLen)

    -- ── Health Bar (left side) ──────────────────────────
    if Config.ShowHealthBar then
        local barH = screenH * 0.8
        local barW = 4
        local barPos = Vector2.new(boxPos.X - barW - 3, boxPos.Y + (screenH - barH)/2)

        if not pDraw.hpBG then
            pDraw.hpBG = Drawing.new("Square")
            pDraw.hpBG.Filled = true
            pDraw.hpBG.Color = Color3.fromRGB(30, 30, 30)
        end
        pDraw.hpBG.Position = barPos
        pDraw.hpBG.Size = Vector2.new(barW, barH)

        if not pDraw.hpBar then
            pDraw.hpBar = Drawing.new("Square")
            pDraw.hpBar.Filled = true
        end
        local hpPct = hp / maxHp
        pDraw.hpBar.Color = hpColor
        pDraw.hpBar.Position = Vector2.new(barPos.X + 1, barPos.Y + barH * (1 - hpPct))
        pDraw.hpBar.Size = Vector2.new(barW - 2, barH * hpPct)
    else
        if pDraw.hpBG then pDraw.hpBG:Remove() pDraw.hpBG = nil end
        if pDraw.hpBar then pDraw.hpBar:Remove() pDraw.hpBar = nil end
    end

    -- ── Tracer from bottom ──────────────────────────────
    if Config.ShowTracer then
        if not pDraw.tracer then
            pDraw.tracer = Drawing.new("Line")
            pDraw.tracer.Color = color
            pDraw.tracer.Thickness = 1.5
            pDraw.tracer.Transparency = 0.5
        end
        pDraw.tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
        pDraw.tracer.To = Vector2.new(pos.X, pos.Y)
    else
        if pDraw.tracer then pDraw.tracer:Remove() pDraw.tracer = nil end
    end

    -- ── Nametag ─────────────────────────────────────────
    if Config.ShowNameTags then
        if not pDraw.name then
            pDraw.name = Drawing.new("Text")
            pDraw.name.Color = Color3.fromRGB(255, 255, 255)
            pDraw.name.Size = 13
            pDraw.name.Outline = true
            pDraw.name.OutlineColor = Color3.fromRGB(0, 0, 0)
            pDraw.name.Center = true
        end
        local nameText = player.Name
        if Config.ShowDistance then
            nameText = string.format("%s | %d/%d HP | %dm", player.Name, math.floor(hp), math.floor(maxHp), math.floor(dist))
        else
            nameText = string.format("%s | %d/%d HP", player.Name, math.floor(hp), math.floor(maxHp))
        end
        pDraw.name.Text = nameText
        pDraw.name.Position = Vector2.new(top.X, top.Y - 16)
    else
        if pDraw.name then pDraw.name:Remove() pDraw.name = nil end
    end

    -- ── Bottom Tag ──────────────────────────────────────
    if not pDraw.bottom then
        pDraw.bottom = Drawing.new("Text")
        pDraw.bottom.Color = Color3.fromRGB(255, 255, 255)
        pDraw.bottom.Size = 11
        pDraw.bottom.Outline = true
        pDraw.bottom.OutlineColor = Color3.fromRGB(0, 0, 0)
        pDraw.bottom.Center = true
    end
    pDraw.bottom.Text = "CYVHUB"
    pDraw.bottom.Position = Vector2.new(top.X, bottom.Y + 4)

    -- ── Skeleton ────────────────────────────────────────
    if Config.ShowSkeleton then
        local connections = getBoneConnections(character)
        for i, bonePair in ipairs(connections) do
            local key = "skel" .. i
            if not pDraw[key] then
                pDraw[key] = Drawing.new("Line")
                pDraw[key].Color = Color3.fromRGB(255, 255, 255)
                pDraw[key].Thickness = 1.2
                pDraw[key].Transparency = 0.4
            end
            local _, v1 = Camera:WorldToViewportPoint(bonePair[1].Position)
            local _, v2 = Camera:WorldToViewportPoint(bonePair[2].Position)
            if v1 and v2 then
                pDraw[key].From = Vector2.new(v1.X, v1.Y)
                pDraw[key].To = Vector2.new(v2.X, v2.Y)
                pDraw[key].Visible = true
            else
                pDraw[key].Visible = false
            end
        end
    else
        -- Remove skeleton lines
        for key, obj in pairs(pDraw) do
            if string.sub(key, 1, 4) == "skel" then
                obj:Remove()
                pDraw[key] = nil
            end
        end
    end
end

local function updateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer or not isEnemy(player) then
            clearPlayerESP(player)
            continue
        end
        if not player.Character then
            clearPlayerESP(player)
            continue
        end
        local humanoid = player.Character:FindFirstChildWhichIsA("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            clearPlayerESP(player)
            continue
        end
        if Config.ShowESP then
            createPlayerESP(player)
        else
            clearPlayerESP(player)
        end
    end
end

