-- ── Mobile Double-Tap Support ──────────────────────────
local lastTapTime = 0
local doubleTapDelay = 0.3 -- seconds

table.insert(connections, UserInputService.TouchTap:Connect(function(touches, processed)
    if processed then return end
    local currentTime = tick()
    if currentTime - lastTapTime < doubleTapDelay then
        -- Double tap detected - lock onto nearest enemy
        Config.RightMouseDown = true
        if not isLockValid() then
            Config.LockOnTarget = getBestTarget()
        end
        -- Auto-release after 2 seconds
        task.delay(2, function()
            Config.RightMouseDown = false
            Config.LockOnTarget = nil
        end)
    end
    lastTapTime = currentTime
end))

table.insert(connections, RunService.RenderStepped:Connect(function()
    if not Config.AimbotToggle or not Config.RightMouseDown then return end

    if not isLockValid() then
        Config.LockOnTarget = getBestTarget()
    end
    if not Config.LockOnTarget then return end

    local character = Config.LockOnTarget.Character
    if not character then Config.LockOnTarget = nil return end
    
    -- Always prioritize Head for aimbot
    local part = character:FindFirstChild("Head")
    if not part then
        part = character:FindFirstChild("UpperTorso")
    end
    if not part then
        part = getTargetPart(character)
    end
    if not part then Config.LockOnTarget = nil return end

    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen or screenPos.Z <= 0 then
        Config.LockOnTarget = nil
        return
    end

    local mousePos  = getMousePos()
    local targetVec = Vector2.new(screenPos.X, screenPos.Y)
    local delta     = targetVec - mousePos

    if delta.Magnitude > Config.FOV then
        Config.LockOnTarget = getBestTarget()
        return
    end

    if Config.AimbotSmoothing then
        -- Smooth lerp: Sensitivity 0.01 = very slow glide, 1.0 = near-instant
        local step  = math.clamp(Config.Sensitivity, 0.01, 1.0)
        mousemoverel(lerpNum(0, delta.X, step), lerpNum(0, delta.Y, step))
    else
        -- Raw snap
        mousemoverel(delta.X, delta.Y)
    end
end))

