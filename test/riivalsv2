local function getMousePos()
    local ml    = UserInputService:GetMouseLocation()
    local inset = GuiService:GetGuiInset()
    return Vector2.new(ml.X - inset.X, ml.Y - inset.Y)
end

local function getAimbotPartName()
    if type(Config.AimbotPart) == "table" then return Config.AimbotPart[1] end
    return Config.AimbotPart
end

local function isValidTarget(player)
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    local hum = player.Character:FindFirstChildWhichIsA("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function isEnemy(player)
    if player == LocalPlayer then return false end
    local lpTeam, pTeam = LocalPlayer.Team, player.Team
    if lpTeam and pTeam and not LocalPlayer.Neutral and not player.Neutral then
        return lpTeam ~= pTeam
    end
    if lpTeam == nil or pTeam == nil then return true end
    local lpId = LocalPlayer:GetAttribute("TeamId")
    local pId  = player:GetAttribute("TeamId")
    if lpId ~= nil and pId ~= nil then return lpId ~= pId end
    if lpId == nil or pId == nil then return true end
    local lpColor, pColor = LocalPlayer.TeamColor, player.TeamColor
    if lpColor and pColor and not LocalPlayer.Neutral and not player.Neutral then
        return lpColor ~= pColor
    end
    return true
end

local function getTargetPart(character)
    local name = getAimbotPartName()
    return character:FindFirstChild(name)
        or character:FindFirstChild("Head")
        or character:FindFirstChildWhichIsA("BasePart")
end

local function getHealthColor(pct)
    pct = math.clamp(pct, 0, 1)
    if pct > 0.5 then
        local t = (pct - 0.5) * 2
        return Color3.new(1 - t, 1, 0)
    else
        return Color3.new(1, pct * 2, 0)
    end
end

local function lerpNum(a, b, t)
    return a + (b - a) * t
end


